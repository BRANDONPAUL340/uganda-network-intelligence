# ============================================================================
# UGANDA NETWORK PLATFORM — ISOLATED TESTING ENVIRONMENT VARIABLE TEMPLATE
# Save a copy as a local, untracked .env file inside your directory
# ============================================================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/network_intelligence_test
PIPELINE_NAME=uganda_network_intelligence_test
ENVIRONMENT=test

# Operational Quality & Threshold Targets (Isolated Testing Configurations)
CRITICAL_AVAILABILITY_PCT=95
CRITICAL_PACKET_LOSS_PCT=5
CRITICAL_LATENCY_MS=70

WARNING_AVAILABILITY_PCT=98
WARNING_PACKET_LOSS_PCT=2
WARNING_LATENCY_MS=40

# Service Level Agreement Tolerances
PIPELINE_SLA_SECONDS=60
MAX_DATA_FRESHNESS_DAYS=1
